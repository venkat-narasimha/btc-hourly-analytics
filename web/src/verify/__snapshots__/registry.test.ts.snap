// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Metric Registry (Phase A) > matches snapshot per metric definition 1`] = `
[
  {
    "conventions": [
      "UTC discrete hours",
      "null log_ret preserved (never dropped or interpolated)",
    ],
    "formula": "N = Total Hourly Observations",
    "id": "kpi.total_bars",
    "kind": "scalar",
    "label": "Dataset Bars",
    "unit": "count",
  },
  {
    "conventions": [
      "Julian leap calendar year constant: 365.25 days",
      "epoch ms timestamps",
    ],
    "formula": "Δt = (t_latest − t_first) / (86,400,000 × 365.25)",
    "id": "kpi.span_years",
    "kind": "scalar",
    "label": "Chronological Scope",
    "unit": "years",
  },
  {
    "conventions": [
      "Expected = 8,760h (standard year) / 8,784h (leap year)",
      "Missing hours correspond strictly to documented Binance maintenance windows",
    ],
    "formula": "Coverage = (Actual Bars / Expected Astronomical Hours) × 100%",
    "id": "kpi.coverage_pct",
    "kind": "provenance",
    "label": "Hourly Data Coverage",
    "unit": "%",
  },
  {
    "conventions": [
      "Nominal USDT settlement price",
      "UTC ordered",
    ],
    "formula": "P_latest = close of final kline in range",
    "id": "kpi.latest_close",
    "kind": "scalar",
    "label": "Latest Price",
    "unit": "USD",
  },
  {
    "conventions": [
      "P_open = open price of first bar in range",
      "P_close = close price of last bar in range",
    ],
    "formula": "Total Return = ((P_close − P_open) / P_open) × 100%",
    "id": "kpi.period_return_pct",
    "kind": "scalar",
    "label": "Period Total Return",
    "unit": "%",
  },
  {
    "conventions": [
      "HighWaterMark_t = max_{i ≤ t} Close_i",
      "Hourly closes only (sub-hourly wicks not captured)",
    ],
    "formula": "MDD = min_t ( (Close_t − HighWaterMark_t) / HighWaterMark_t ) × 100%",
    "id": "kpi.max_drawdown",
    "kind": "scalar",
    "label": "Maximum Drawdown",
    "unit": "%",
  },
  {
    "conventions": [
      "UTC hourly buckets 00:00–23:00",
      "null log_ret excluded",
      "returns in basis points",
    ],
    "formula": "argmax_h ( (1 / N_h) × Σ_{t ∈ h} log_ret_t × 10,000 )",
    "id": "kpi.best_hour",
    "kind": "scalar",
    "label": "Best Hour (Mean Return)",
    "unit": "bps",
  },
  {
    "conventions": [
      "UTC hourly buckets 00:00–23:00",
      "null log_ret excluded",
      "returns in basis points",
    ],
    "formula": "argmin_h ( (1 / N_h) × Σ_{t ∈ h} log_ret_t × 10,000 )",
    "id": "kpi.worst_hour",
    "kind": "scalar",
    "label": "Worst Hour (Mean Return)",
    "unit": "bps",
  },
  {
    "conventions": [
      "Mon=0, Tue=1, ..., Sun=6",
      "null log_ret excluded",
      "returns in basis points",
    ],
    "formula": "argmax_d ( (1 / N_d) × Σ_{t ∈ d} log_ret_t × 10,000 )",
    "id": "kpi.best_dow",
    "kind": "scalar",
    "label": "Best Day of Week",
    "unit": "bps",
  },
  {
    "conventions": [
      "Mon=0, Tue=1, ..., Sun=6",
      "null log_ret excluded",
      "returns in basis points",
    ],
    "formula": "argmin_d ( (1 / N_d) × Σ_{t ∈ d} log_ret_t × 10,000 )",
    "id": "kpi.worst_dow",
    "kind": "scalar",
    "label": "Worst Day of Week",
    "unit": "bps",
  },
  {
    "conventions": [
      "null log_ret excluded from denominator",
      "strictly positive return count",
    ],
    "formula": "Win Rate = (N(log_ret > 0) / N_valid) × 100%",
    "id": "kpi.hourly_win_rate",
    "kind": "scalar",
    "label": "Hourly Win Rate",
    "unit": "%",
  },
  {
    "conventions": [
      "null log_ret excluded",
      "basis points (bps = return × 10,000)",
    ],
    "formula": "Mean Return = (1 / N_valid) × Σ log_ret × 10,000 bps",
    "id": "kpi.mean_hourly_return",
    "kind": "scalar",
    "label": "Mean Hourly Return",
    "unit": "bps",
  },
  {
    "conventions": [
      "UTC calendar years",
      "Expected 8,760h (8,784h leap)",
    ],
    "formula": "N_y = Count of hourly bars in year y (UTC)",
    "id": "kpi.per_year_counts",
    "kind": "grouped",
    "label": "Annual Observation Counts",
    "unit": "count",
  },
  {
    "conventions": [
      "UTC discrete buckets",
      "null log_ret excluded",
      "basis points",
    ],
    "formula": "Mean Return_bucket = (1 / N_bucket) × Σ_{t ∈ bucket} log_ret_t × 10,000",
    "id": "seasonality.mean_return",
    "kind": "grouped",
    "label": "Seasonality: Mean Return",
    "unit": "bps",
  },
  {
    "conventions": [
      "Sample standard deviation ÷(N−1)",
      "null log_ret excluded",
      "returns 0 for N < 2",
    ],
    "formula": "σ_bucket = √[ 1 / (N_bucket − 1) × Σ_{t ∈ bucket} (r_t − r̄_bucket)² ] × 10,000",
    "id": "seasonality.volatility",
    "kind": "grouped",
    "label": "Seasonality: Volatility (σ)",
    "unit": "bps",
  },
  {
    "conventions": [
      "null log_ret excluded",
      "strictly positive return fraction",
    ],
    "formula": "Win Rate_bucket = ( N(log_ret > 0)_{bucket} / N_valid_{bucket} ) × 100%",
    "id": "seasonality.win_rate",
    "kind": "grouped",
    "label": "Seasonality: Win Rate",
    "unit": "%",
  },
  {
    "conventions": [
      "Aggregated base asset volume in BTC",
      "all bars in bucket summed",
    ],
    "formula": "Total Volume_bucket = Σ_{t ∈ bucket} volume_t",
    "id": "seasonality.total_volume",
    "kind": "grouped",
    "label": "Seasonality: Total Volume",
    "unit": "BTC",
  },
  {
    "conventions": [
      "Ratio of sums (not mean of ratios)",
      ">0.50 denotes net aggressive buyer flow",
    ],
    "formula": "TBR_bucket = Σ_{t ∈ bucket} taker_buy_volume_t / Σ_{t ∈ bucket} volume_t",
    "id": "seasonality.taker_buy_ratio",
    "kind": "grouped",
    "label": "Seasonality: Taker Buy Ratio",
    "unit": "ratio",
  },
  {
    "conventions": [
      "hl_range = (high − low) / open",
      "basis points",
    ],
    "formula": "Mean Range_bucket = (1 / N_bucket) × Σ_{t ∈ bucket} hl_range_t × 10,000",
    "id": "seasonality.mean_hl_range",
    "kind": "grouped",
    "label": "Seasonality: Mean H-L Range",
    "unit": "bps",
  },
  {
    "conventions": [
      "UTC discrete buckets",
      "null log_ret excluded",
      "basis points",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Mean Return across bars where Day=dow and Hour=hour",
    "id": "heatmap.mean_return",
    "kind": "matrix",
    "label": "Heatmap: Mean Return",
    "unit": "bps",
  },
  {
    "conventions": [
      "Sample standard deviation ÷(N−1)",
      "null log_ret excluded",
      "returns 0 for N < 2",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Volatility (σ) across bars where Day=dow and Hour=hour",
    "id": "heatmap.volatility",
    "kind": "matrix",
    "label": "Heatmap: Volatility (σ)",
    "unit": "bps",
  },
  {
    "conventions": [
      "null log_ret excluded",
      "strictly positive return fraction",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Win Rate across bars where Day=dow and Hour=hour",
    "id": "heatmap.win_rate",
    "kind": "matrix",
    "label": "Heatmap: Win Rate",
    "unit": "%",
  },
  {
    "conventions": [
      "Aggregated base asset volume in BTC",
      "all bars in bucket summed",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Total Volume across bars where Day=dow and Hour=hour",
    "id": "heatmap.total_volume",
    "kind": "matrix",
    "label": "Heatmap: Total Volume",
    "unit": "BTC",
  },
  {
    "conventions": [
      "Ratio of sums (not mean of ratios)",
      ">0.50 denotes net aggressive buyer flow",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Taker Buy Ratio across bars where Day=dow and Hour=hour",
    "id": "heatmap.taker_buy_ratio",
    "kind": "matrix",
    "label": "Heatmap: Taker Buy Ratio",
    "unit": "ratio",
  },
  {
    "conventions": [
      "hl_range = (high − low) / open",
      "basis points",
      "Bivariate cross-tabulation: 7 days × 24 hours (168 cells)",
      "Multiple testing hazard: 168 simultaneous buckets",
    ],
    "formula": "Cell(dow, hour) = Mean H-L Range across bars where Day=dow and Hour=hour",
    "id": "heatmap.mean_hl_range",
    "kind": "matrix",
    "label": "Heatmap: Mean H-L Range",
    "unit": "bps",
  },
  {
    "conventions": [
      "Sample stddev ÷(W−1) over non-null log_ret within sliding window",
      "Window W in hourly bars (default 168h = 7 days)",
      "Emits points starting at index W−1",
    ],
    "formula": "σ_t = √[ 1 / (W − 1) × Σ_{i = t−W+1}^t (r_i − r̄_W)² ] × 10,000 bps",
    "id": "volatility.rolling_vol",
    "kind": "series",
    "label": "Rolling Volatility (σ)",
    "unit": "bps",
  },
  {
    "conventions": [
      "Arithmetic mean of all non-null log returns in basis points",
    ],
    "formula": "μ = (1 / N) × Σ log_ret × 10,000 bps",
    "id": "volatility.distribution_mean",
    "kind": "scalar",
    "label": "Distribution Mean Return",
    "unit": "bps",
  },
  {
    "conventions": [
      "Sample standard deviation ÷(N−1)",
      "null log_ret excluded",
    ],
    "formula": "s = √[ 1 / (N − 1) × Σ (r_i − μ)² ] × 10,000 bps",
    "id": "volatility.distribution_std",
    "kind": "scalar",
    "label": "Distribution Sample Std Dev",
    "unit": "bps",
  },
  {
    "conventions": [
      "Fisher-Pearson standardized population 3rd moment",
      "Unbiased population divisor N",
    ],
    "formula": "g₁ = m₃ / m₂^{3/2}, where m_k = (1 / N) × Σ (r_i − μ)^k",
    "id": "volatility.distribution_skewness",
    "kind": "scalar",
    "label": "Distribution Skewness (g₁)",
    "unit": "ratio",
  },
  {
    "conventions": [
      "Excess kurtosis relative to Gaussian normal distribution (normal = 0)",
      "g₂ > 0 indicates fat tails / leptokurtosis",
    ],
    "formula": "g₂ = (m₄ / m₂²) − 3",
    "id": "volatility.distribution_kurtosis",
    "kind": "scalar",
    "label": "Distribution Excess Kurtosis (g₂)",
    "unit": "ratio",
  },
  {
    "conventions": [
      "Nearest-rank discrete quantile method",
      "Sorted non-null log returns in bps",
    ],
    "formula": "Q(p) = sorted_returns[ floor(p × N) ] in basis points",
    "id": "volatility.quantiles",
    "kind": "grouped",
    "label": "Empirical Quantiles",
    "unit": "bps",
  },
  {
    "conventions": [
      "Summary-only parity: n, min, max (bins are visual formatting)",
      "Equal-width binning spanning min to max observed return",
    ],
    "formula": "Partition of return range into 50 equal-width bins",
    "id": "volatility.histogram",
    "kind": "grouped",
    "label": "Return Distribution Histogram",
    "unit": "count",
  },
  {
    "conventions": [
      "Net aggressive market order imbalance in contracts/BTC",
      "Unbounded cumulative prefix sum",
    ],
    "formula": "Δ_t = (2 × taker_buy_volume_t) − volume_t,   CVD_t = Σ_{i=0}^t Δ_i",
    "id": "flow.cvd",
    "kind": "series",
    "label": "Cumulative Taker Delta (CVD)",
    "unit": "BTC",
  },
  {
    "conventions": [
      "Ratio of sums expressed as percentage",
      ">50% indicates aggressive buyer dominance",
    ],
    "formula": "TBR_h = ( Σ_{t ∈ h} taker_buy_volume_t / Σ_{t ∈ h} volume_t ) × 100%",
    "id": "flow.taker_buy_ratio",
    "kind": "grouped",
    "label": "Hourly Taker Buy Ratio (TBR)",
    "unit": "%",
  },
  {
    "conventions": [
      "Open of first hourly candle of the month to close of last candle",
      "Exact calendar months (28–31 days, 672–744 bars)",
    ],
    "formula": "R_{y,m} = ((P_close_{last} − P_open_{first}) / P_open_{first}) × 100%",
    "id": "calendar.monthly_returns",
    "kind": "matrix",
    "label": "Monthly Returns (Year × Month)",
    "unit": "%",
  },
  {
    "conventions": [
      "Discrete monthly compounding product",
      "Current year includes available months to date",
    ],
    "formula": "R_YTD = [ Π_{m=1}^M (1 + R_m / 100) − 1 ] × 100%",
    "id": "calendar.ytd",
    "kind": "grouped",
    "label": "Year-to-Date (YTD) Compound Return",
    "unit": "%",
  },
  {
    "conventions": [
      "Peak_t = max_{i ≤ t} Close_i (running high-water mark)",
      "Hourly bar close evaluations",
    ],
    "formula": "Drawdown_t = ((Close_t − Peak_t) / Peak_t) × 100%",
    "id": "calendar.drawdown_series",
    "kind": "series",
    "label": "Drawdown Series",
    "unit": "%",
  },
  {
    "conventions": [
      "Every monthly and daily archive validated against Binance Vision official .CHECKSUM files",
      "Verified independently by external verification kit",
    ],
    "formula": "SHA-256(archive.zip) == Binance_Official_Checksum",
    "id": "quality.checksums",
    "kind": "provenance",
    "label": "Binance Archive Checksum Audit",
    "unit": "count",
  },
  {
    "conventions": [
      "Missing hours reflect actual matching engine outage intervals",
      "Zero synthetic bars injected into historical series",
    ],
    "formula": "Continuous chronological hours strictly preserved with zero synthetic forward-filling",
    "id": "quality.gaps",
    "kind": "provenance",
    "label": "Exchange Maintenance Gaps",
    "unit": "count",
  },
  {
    "conventions": [
      "hyparquet zero-network in-browser range requests",
      "Client reads static release artifact directly",
    ],
    "formula": "Immutable Parquet release artifact generated via automated pipeline",
    "id": "quality.provenance",
    "kind": "provenance",
    "label": "Pipeline Data Lineage & Provenance",
    "unit": "string",
  },
]
`;
